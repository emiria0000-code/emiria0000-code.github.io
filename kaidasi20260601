<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>業務スーパー活用 1週間献立 No.2 買い出しリスト</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap');
        body { font-family: 'Noto+Sans+JP', sans-serif; background-color: #f8fafc; }
        .package-card { transition: all 0.2s; border-radius: 1.25rem; overflow: hidden; }
        .checked { opacity: 0.4; background-color: #f1f5f9 !important; border-color: #cbd5e1 !important; }
        .checked .item-name { text-decoration: line-through; color: #64748b; }
        .photo-btn { background: linear-gradient(135deg, #059669, #10b981); }
        .alt-badge { background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    </style>
</head>
<body class="pb-24">

    <!-- ヘッダー -->
    <header class="bg-[#008931] text-white p-4 sticky top-0 z-50 shadow-lg">
        <div class="max-w-md mx-auto flex justify-between items-center">
            <div>
                <h1 class="text-base font-bold">業務スーパー活用 1週間献立 No.2</h1>
                <p class="text-[10px] opacity-90">大人2人・子供2人 / 買い出しリスト</p>
            </div>
            <div class="text-right">
                <span class="text-[9px] block opacity-80">予算目安</span>
                <span class="font-bold text-yellow-300 text-sm">¥7,800〜8,800</span>
            </div>
        </div>
    </header>

    <main class="max-w-md mx-auto p-4 space-y-6">

        <!-- 店舗タブ切り替え -->
        <div class="flex rounded-lg bg-gray-200 p-1 shadow-sm">
            <button onclick="switchTab('gs')" id="tab-gs" class="flex-1 py-2 text-xs font-bold rounded-md bg-white text-green-800 shadow-sm transition-all">
                🟢 業務スーパーで買うもの
            </button>
            <button onclick="switchTab('super')" id="tab-super" class="flex-1 py-2 text-xs font-bold rounded-md text-gray-600 transition-all">
                🔵 一般スーパーで買うもの
            </button>
        </div>

        <!-- ==================== 🟢 業務スーパーのリスト ==================== -->
        <div id="section-gs" class="space-y-6">
            
            <!-- 冷凍肉・魚 -->
            <div>
                <h2 class="flex items-center text-xs font-bold mb-3 text-green-700 border-l-4 border-green-500 pl-2 uppercase tracking-wider">
                    冷凍肉・魚 (メイン食材 - 被りなし！)
                </h2>
                <div class="grid gap-3">
                    
                    <!-- 吉備高原どりむね肉 -->
                    <div class="package-card bg-white border-2 border-green-100 p-3 flex gap-3 shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="w-16 h-16 bg-green-50 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">🐔</div>
                        <div class="flex-1">
                            <h3 class="item-name font-bold text-sm">吉備高原どり 若どりむね肉 (2kg)</h3>
                            <p class="text-[10px] text-gray-500 mb-1">コスパ最強。初日にまとめてハサミで切って小分け保存します。</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="viewPhoto(event, '業務スーパー 吉備高原どり 若どりむね肉 2kg')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full"><i class="fas fa-camera mr-1"></i>写真を確認</button>
                                <span class="alt-badge text-[8px] px-2 py-0.5 rounded-full">代：鶏トロ肉(肩肉)、若どりもも肉2kg</span>
                            </div>
                        </div>
                        <input type="checkbox" class="w-5 h-5 mt-1" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                    <!-- 豚肩ローススライス -->
                    <div class="package-card bg-white border-2 border-red-100 p-3 flex gap-3 shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="w-16 h-16 bg-red-50 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">🥓</div>
                        <div class="flex-1">
                            <h3 class="item-name font-bold text-sm">豚肩ローススライス (500g)</h3>
                            <p class="text-[10px] text-gray-500 mb-1">肩ロースならではの旨味。炒め物や生姜焼きに最適。</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="viewPhoto(event, '業務スーパー 冷凍 豚肩ローススライス 500g')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full"><i class="fas fa-camera mr-1"></i>写真を確認</button>
                                <span class="alt-badge text-[8px] px-2 py-0.5 rounded-full">代：豚バラスライス、豚こま切れ肉</span>
                            </div>
                        </div>
                        <input type="checkbox" class="w-5 h-5 mt-1" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                    <!-- 豚ミンチ -->
                    <div class="package-card bg-white border-2 border-orange-100 p-3 flex gap-3 shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="w-16 h-16 bg-orange-50 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">🥩</div>
                        <div class="flex-1">
                            <h3 class="item-name font-bold text-sm">冷凍 豚ミンチ (500g)</h3>
                            <p class="text-[10px] text-gray-500 mb-1">バラ凍結なので必要な分だけパラパラ使えます。</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="viewPhoto(event, '業務スーパー 冷凍 豚ミンチ 500g')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full"><i class="fas fa-camera mr-1"></i>写真を確認</button>
                                <span class="alt-badge text-[8px] px-2 py-0.5 rounded-full">代：冷凍 合挽ミンチ</span>
                            </div>
                        </div>
                        <input type="checkbox" class="w-5 h-5 mt-1" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                    <!-- 鶏生だんご -->
                    <div class="package-card bg-white border-2 border-yellow-100 p-3 flex gap-3 shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="w-16 h-16 bg-yellow-50 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">🍡</div>
                        <div class="flex-1">
                            <h3 class="item-name font-bold text-sm">冷凍 鶏生だんご プレーン (500g)</h3>
                            <p class="text-[10px] text-gray-500 mb-1">お肉の旨みが抜群。煮るとふんわり仕上がる生タイプ。</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="viewPhoto(event, '業務スーパー 冷凍 鶏生だんご 500g')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full"><i class="fas fa-camera mr-1"></i>写真を確認</button>
                                <span class="alt-badge text-[8px] px-2 py-0.5 rounded-full">代：冷凍肉だんご、つくね</span>
                            </div>
                        </div>
                        <input type="checkbox" class="w-5 h-5 mt-1" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                    <!-- さば切身 -->
                    <div class="package-card bg-white border-2 border-blue-100 p-3 flex gap-3 shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="w-16 h-16 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">🐟</div>
                        <div class="flex-1">
                            <h3 class="item-name font-bold text-sm">骨取りさば切身 (冷凍)</h3>
                            <p class="text-[10px] text-gray-500 mb-1">骨がないから子供でもパクパク食べやすい人気のサバ。</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="viewPhoto(event, '業務スーパー 冷凍 骨取りさば切身')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full"><i class="fas fa-camera mr-1"></i>写真を確認</button>
                                <span class="alt-badge text-[8px] px-2 py-0.5 rounded-full">代：冷凍サバ塩焼き用、カレイ切身</span>
                            </div>
                        </div>
                        <input type="checkbox" class="w-5 h-5 mt-1" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                    <!-- 大粒大容量むきえび -->
                    <div class="package-card bg-white border-2 border-indigo-100 p-3 flex gap-3 shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="w-16 h-16 bg-indigo-50 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">🦐</div>
                        <div class="flex-1">
                            <h3 class="item-name font-bold text-sm">大粒むきえび (300g〜500g)</h3>
                            <p class="text-[10px] text-gray-500 mb-1">面倒な殻剥き・背わた処理済み。ぷりぷりのエビマヨに。</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="viewPhoto(event, '業務スーパー 冷凍 大粒むきえび')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full"><i class="fas fa-camera mr-1"></i>写真を確認</button>
                                <span class="alt-badge text-[8px] px-2 py-0.5 rounded-full">代：冷凍シーフードミックス、いかスライス</span>
                            </div>
                        </div>
                        <input type="checkbox" class="w-5 h-5 mt-1" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                    <!-- チキンカツ -->
                    <div class="package-card bg-white border-2 border-amber-100 p-3 flex gap-3 shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="w-16 h-16 bg-amber-50 rounded-lg flex items-center justify-center flex-shrink-0 text-2xl">🍗</div>
                        <div class="flex-1">
                            <h3 class="item-name font-bold text-sm">ちょっと贅沢なチキンカツ (1kg)</h3>
                            <p class="text-[10px] text-gray-500 mb-1">揚げるだけ（フライパンで多めの油で焼くだけ）で絶品おかず。</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="viewPhoto(event, '業務スーパー ちょっと贅沢なチキンカツ')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full"><i class="fas fa-camera mr-1"></i>写真を確認</button>
                                <span class="alt-badge text-[8px] px-2 py-0.5 rounded-full">代：手結び白身魚フライ、チキンナゲット</span>
                            </div>
                        </div>
                        <input type="checkbox" class="w-5 h-5 mt-1" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                </div>
            </div>

            <!-- 冷凍野菜ミックス（切る手間ゼロの極み！） -->
            <div>
                <h2 class="flex items-center text-xs font-bold mb-3 text-green-700 border-l-4 border-green-500 pl-2 uppercase tracking-wider">
                    冷凍野菜ミックス（今回はこちらを大活用！）
                </h2>
                <div class="grid grid-cols-2 gap-3">
                    
                    <div class="package-card bg-white border-2 border-orange-50 p-3 text-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="text-2xl mb-1">🥡</div>
                        <div class="item-name text-xs font-bold">中華野菜ミックス (500g)</div>
                        <p class="text-[8px] text-gray-500">いんげん、にんじん、きくらげ、たけのこ等</p>
                        <button onclick="viewPhoto(event, '業務スーパー 冷凍 中華野菜ミックス')" class="photo-btn text-white text-[8px] px-2 py-0.5 rounded-full mt-1.5"><i class="fas fa-camera mr-1"></i>写真</button>
                        <div class="alt-badge text-[7px] mt-1.5 p-0.5 rounded">代：和風野菜ミックス</div>
                        <div class="flex justify-center mt-2">
                            <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                        </div>
                    </div>

                    <div class="package-card bg-white border-2 border-blue-50 p-3 text-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="text-2xl mb-1">🥕</div>
                        <div class="item-name text-xs font-bold">洋風野菜ミックス (500g)</div>
                        <p class="text-[8px] text-gray-500">ブロッコリー、にんじん、カリフラワー</p>
                        <button onclick="viewPhoto(event, '業務スーパー 冷凍 洋風野菜ミックス')" class="photo-btn text-white text-[8px] px-2 py-0.5 rounded-full mt-1.5"><i class="fas fa-camera mr-1"></i>写真</button>
                        <div class="alt-badge text-[7px] mt-1.5 p-0.5 rounded">代：ブロッコリー(500g)</div>
                        <div class="flex justify-center mt-2">
                            <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                        </div>
                    </div>

                    <div class="package-card bg-white border-2 border-yellow-50 p-3 text-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="text-2xl mb-1">🧅</div>
                        <div class="item-name text-xs font-bold">スライスたまねぎ (500g)</div>
                        <p class="text-[8px] text-gray-500">炒め物にボリューム感を出すスライス型</p>
                        <button onclick="viewPhoto(event, '業務スーパー 冷凍 スライスたまねぎ')" class="photo-btn text-white text-[8px] px-2 py-0.5 rounded-full mt-1.5"><i class="fas fa-camera mr-1"></i>写真</button>
                        <div class="alt-badge text-[7px] mt-1.5 p-0.5 rounded">代：きざみたまねぎ</div>
                        <div class="flex justify-center mt-2">
                            <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                        </div>
                    </div>

                    <div class="package-card bg-white border-2 border-emerald-50 p-3 text-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="text-2xl mb-1">🟢</div>
                        <div class="item-name text-xs font-bold">むき枝豆 (500g)</div>
                        <p class="text-[8px] text-gray-500">塩コショウ炒めやマヨサラダの彩りに</p>
                        <button onclick="viewPhoto(event, '業務スーパー 冷凍 むき枝豆')" class="photo-btn text-white text-[8px] px-2 py-0.5 rounded-full mt-1.5"><i class="fas fa-camera mr-1"></i>写真</button>
                        <div class="alt-badge text-[7px] mt-1.5 p-0.5 rounded">代：塩茹で枝豆</div>
                        <div class="flex justify-center mt-2">
                            <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                        </div>
                    </div>

                    <div class="package-card bg-white border-2 border-purple-50 p-3 text-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="text-2xl mb-1">🥒</div>
                        <div class="item-name text-xs font-bold">スライスズッキーニ (500g)</div>
                        <p class="text-[8px] text-gray-500">ソテーやシチュー、チーズ焼きに大活躍</p>
                        <button onclick="viewPhoto(event, '業務スーパー 冷凍 ズッキーニ')" class="photo-btn text-white text-[8px] px-2 py-0.5 rounded-full mt-1.5"><i class="fas fa-camera mr-1"></i>写真</button>
                        <div class="alt-badge text-[7px] mt-1.5 p-0.5 rounded">代：冷凍揚げなす</div>
                        <div class="flex justify-center mt-2">
                            <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                        </div>
                    </div>

                </div>
            </div>

            <!-- 調味料・その他チルド（ポテサラからマカロニに被りなしアレンジ！） -->
            <div>
                <h2 class="flex items-center text-xs font-bold mb-3 text-green-700 border-l-4 border-green-500 pl-2 uppercase tracking-wider">
                    チルド加工品・ルー
                </h2>
                <div class="grid gap-3">
                    
                    <div class="package-card bg-white border-2 border-sky-100 p-3 flex justify-between items-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="flex items-center gap-3">
                            <span class="text-xl">🥗</span>
                            <div>
                                <h3 class="item-name font-bold text-sm">マカロニサラダ (1kg)</h3>
                                <p class="text-[9px] text-gray-500">今回はポテサラと被らないようマカロニに変更！ボリューム抜群。</p>
                                <button onclick="viewPhoto(event, '業務スーパー マカロニサラダ 1kg')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full mt-1"><i class="fas fa-camera mr-1"></i>写真</button>
                            </div>
                        </div>
                        <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                    <div class="package-card bg-white border-2 border-amber-100 p-3 flex justify-between items-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                        <div class="flex items-center gap-3">
                            <span class="text-xl">🍛</span>
                            <div>
                                <h3 class="item-name font-bold text-sm">クリームシチュールー (1箱)</h3>
                                <p class="text-[9px] text-gray-500">日曜日の全部のせシチュー用。</p>
                                <button onclick="viewPhoto(event, '業務スーパー クリームシチュー ルー')" class="photo-btn text-white text-[9px] px-2 py-0.5 rounded-full mt-1"><i class="fas fa-camera mr-1"></i>写真</button>
                            </div>
                        </div>
                        <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                    </div>

                </div>
            </div>
        </div>

        <!-- ==================== 🔵 一般スーパーのリスト ==================== -->
        <div id="section-super" class="space-y-4 hidden">
            <h2 class="flex items-center text-xs font-bold mb-1 text-blue-700 border-l-4 border-blue-500 pl-2 uppercase tracking-wider">
                新鮮な生鮮野菜・乳製品など
            </h2>
            <div class="grid gap-3">
                
                <!-- レタス -->
                <div class="package-card bg-white border-2 border-slate-100 p-3 flex justify-between items-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">🥬</span>
                        <div>
                            <h3 class="item-name font-bold text-sm">レタス (1玉)</h3>
                            <p class="text-[10px] text-gray-500">包丁不要！初日にちぎって袋保存で劇的に楽になります。</p>
                        </div>
                    </div>
                    <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                </div>

                <div class="package-card bg-white border-2 border-slate-100 p-3 flex justify-between items-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">🥚</span>
                        <h3 class="item-name font-bold text-sm">卵 (10個入) × 1〜2パック</h3>
                    </div>
                    <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                </div>

                <div class="package-card bg-white border-2 border-slate-100 p-3 flex justify-between items-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">⬜</span>
                        <h3 class="item-name font-bold text-sm">豆腐 (3個パック) × 2パック</h3>
                    </div>
                    <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                </div>

                <div class="package-card bg-white border-2 border-slate-100 p-3 flex justify-between items-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">🍅</span>
                        <h3 class="item-name font-bold text-sm">プチトマト (彩り用)</h3>
                    </div>
                    <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                </div>

                <div class="package-card bg-white border-2 border-blue-50 p-3 flex justify-between items-center shadow-sm cursor-pointer" onclick="toggleItem(this)">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">🥛</span>
                        <h3 class="item-name font-bold text-sm">牛乳・朝食パン・お米</h3>
                    </div>
                    <input type="checkbox" onclick="event.stopPropagation(); toggleItem(this.closest('.package-card'))">
                </div>

            </div>
        </div>

    </main>

    <!-- 下部プログレスバー -->
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 shadow-2xl z-50">
        <div class="max-w-md mx-auto">
            <div class="flex justify-between items-center mb-2 text-[10px] text-gray-500">
                <span id="store-hint" class="font-bold">🟢 業務スーパーでお買い物中</span>
                <span>チェック: <span id="checkCount" class="font-bold text-gray-800">0</span> / 18 品</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">
                <div id="progressBar" class="bg-green-500 h-full w-0 transition-all duration-300"></div>
            </div>
        </div>
    </div>

    <script>
        // タブ切り替え機能
        function switchTab(target) {
            const btnGs = document.getElementById('tab-gs');
            const btnSuper = document.getElementById('tab-super');
            const secGs = document.getElementById('section-gs');
            const secSuper = document.getElementById('section-super');
            const hint = document.getElementById('store-hint');

            if (target === 'gs') {
                btnGs.className = "flex-1 py-2 text-xs font-bold rounded-md bg-white text-green-800 shadow-sm transition-all";
                btnSuper.className = "flex-1 py-2 text-xs font-bold rounded-md text-gray-600 transition-all";
                secGs.classList.remove('hidden');
                secSuper.classList.add('hidden');
                hint.textContent = '🟢 業務スーパーでお買い物中';
                hint.className = 'font-bold text-green-700';
            } else {
                btnSuper.className = "flex-1 py-2 text-xs font-bold rounded-md bg-white text-blue-800 shadow-sm transition-all";
                btnGs.className = "flex-1 py-2 text-xs font-bold rounded-md text-gray-600 transition-all";
                secSuper.classList.remove('hidden');
                secGs.classList.add('hidden');
                hint.textContent = '🔵 一般スーパーでお買い物中';
                hint.className = 'font-bold text-blue-700';
            }
        }

        // タップした時にチェックボックスを反転させて進捗を更新
        function toggleItem(card) {
            const checkbox = card.querySelector('input[type="checkbox"]');
            checkbox.checked = !checkbox.checked;
            card.classList.toggle('checked', checkbox.checked);
            updateProgress();
        }

        // プログレスバーの更新
        function updateProgress() {
            const total = document.querySelectorAll('input[type="checkbox"]').length;
            const checked = document.querySelectorAll('input[type="checkbox"]:checked').length;
            document.getElementById('checkCount').textContent = checked;
            
            const percentage = (checked / total) * 100;
            document.getElementById('progressBar').style.width = percentage + '%';
        }

        // Google画像検索を開く
        function viewPhoto(event, query) {
            event.stopPropagation(); // 親要素のカードクリックイベント（チェックボックス反転）が発火するのを防ぐ
            window.open(`https://www.google.com/search?q=${encodeURIComponent(query)}&tbm=isch`, '_blank');
        }
    </script>
</body>
</html>
